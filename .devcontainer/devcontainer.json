{
    "name": "Embewi ESP32 Rust",

    "build": {
        "dockerfile": "../docker/Dockerfile",
        "context": ".."
    },

    "workspaceFolder": "/workspace",

    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind"
    ],

    "forwardPorts": [
        8080
    ],

    "portsAttributes": {
        "8080": {
            "label": "ESP Web Tools",
            "onAutoForward": "notify"
        }
    },

    "containerEnv": {
        "RUST_BACKTRACE": "1"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "rust-analyzer.check.command": "check"
            }
        }
    },

    "postCreateCommand": "bash -lc '. /opt/esp/export-esp.sh && rustc --version && cargo --version && espup --version && espflash --version && esp-generate --version'",

    "postStartCommand": "bash -lc 'pkill -f \"http-server /workspace/web\" || true; nohup http-server /workspace/web -p 8080 -c-1 > /tmp/http-server.log 2>&1 & disown'",

    "remoteUser": "root"
}
